#include <windows.h>

1 ICON "assets/altcmd.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,2,0
 PRODUCTVERSION 1,0,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "AltCmd\0"
			VALUE "FileDescription", "AltCmd\0"
			VALUE "FileVersion", "1.0.2.0\0"
			VALUE "InternalName", "AltCmd\0"
			VALUE "OriginalFilename", "AltCmd.exe\0"
			VALUE "ProductName", "AltCmd\0"
			VALUE "ProductVersion", "1.0.2.0\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
